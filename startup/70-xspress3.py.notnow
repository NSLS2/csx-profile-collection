"""Opt-in CSX Xspress3 device and interactive plans.

Run this file from the configured CSX IPython profile, where ``RE`` is defined.
"""

from pathlib import PurePosixPath

import bluesky.plan_stubs as bps
import bluesky.plans as bp
from nslsii.ophyd_async import NSLS2PathProvider
from nslsii.ophyd_async.devices import (
    Xspress3Detector,
    Xspress3HDFWriterFactory,
)


xsp3 = Xspress3Detector(
    "XF:23ID1-ES{XP3}:",
    Xspress3HDFWriterFactory(
        NSLS2PathProvider(
            RE.md,
            base_data_dir=PurePosixPath("/nsls2/data/csx/proposals"),
        ),
        writer_suffix="HDF1:",
        include_roi_streams=True,
        include_sca_streams=False,
        hinted_streams=("channel1-roi1", "channel1-roi2"),
    ),
    channel_numbers=(1,),
    mca_roi_numbers=tuple(range(1, 17)),
    driver_suffix="det1:",
    include_roi_reset=False,
    name="xsp3",
)


def ct_xsp3(dets, num=1, **kwargs):
    """Count detectors without legacy Xspress3 acquisition state."""
    return (yield from bp.count(dets, num=num, **kwargs))


def setup_rois(channel, roi_width):
    """Configure consecutive half-open bins while preserving ROI enablement."""
    for index, roi in enumerate(channel.rois.values()):
        enabled = yield from bps.rd(roi.enabled)
        low_bin = index * roi_width
        high_bin = (index + 1) * roi_width
        yield from bps.wait_for(
            [
                lambda roi=roi, low=low_bin, high=high_bin, enabled=enabled: (
                    roi.set_roi_bins(low, high, enabled=enabled)
                )
            ]
        )


def roi_for_elements(channel, list_of_elm):
    """Configure consecutive ROIs for named elemental ranges."""
    for roi, element in zip(channel.rois.values(), list_of_elm):
        enabled = yield from bps.rd(roi.enabled)
        low_bin, high_bin = get_range(element)
        yield from bps.wait_for(
            [
                lambda roi=roi, low=low_bin, high=high_bin, enabled=enabled: (
                    roi.set_roi_bins(low, high, enabled=enabled)
                )
            ]
        )


def get_range(elm):
    """Return the established half-open MCA range for an element."""
    elm_map = {"Fe": [70, 72], "Ni": [84, 86]}
    return elm_map[elm]
